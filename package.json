    "build:dev:local": "node scripts/build-local-apk.cjs --debug",
    "build:preview": "npx eas build --platform android --profile preview --non-interactive",
    "build:preview:local": "node scripts/build-local-apk.cjs",
    "build:prod": "npx eas build --platform android --profile production --non-interactive",
    "build:prod:local": "node scripts/build-local-apk.cjs",
