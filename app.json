{
  "expo": {
    "name": "Ourlime",
    "slug": "ourlime",
    "version": "1.3.2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/b2bd2a8c-17f8-4d08-8233-42ccb475a4e5",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "default",
    "icon": "./assets/images/app-icon.png",
    "scheme": "ourlime",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ourlime.app",
      "buildNumber": "1",
      "deploymentTarget": "15.1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:ourlime.com"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Ourlime uses the camera for video calls and when you choose to capture profile, listing, verification, or post media.",
        "NSMicrophoneUsageDescription": "Ourlime requires microphone access for voice and video calls and to record voice notes in chat.",
        "NSPhotoLibraryUsageDescription": "Ourlime lets you choose photos and videos for your profile, posts, listings, storefronts, messages, and verification submissions.",
        "NSLocationWhenInUseUsageDescription": "Ourlime uses your location only when you choose location-aware discovery or add a location to content.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "googlegmail",
          "ms-outlook",
          "ymail",
          "protonmail",
          "message",
          "mailto"
        ]
      }
    },
    "android": {
      "package": "com.ourlime.app",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ourlime.com",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "ourlime.com",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "ourlime.com",
              "pathPrefix": "/communities"
            },
            {
              "scheme": "https",
              "host": "ourlime.com",
              "pathPrefix": "/blogs"
            },
            {
              "scheme": "https",
              "host": "ourlime.com",
              "pathPrefix": "/limes"
            },
            {
              "scheme": "https",
              "host": "ourlime.com",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "ourlime.com",
              "pathPrefix": "/jobs"
            },
            {
              "scheme": "https",
              "host": "ourlime.com",
              "pathPrefix": "/market"
            },
            {
              "scheme": "https",
              "host": "ourlime.com",
              "pathPrefix": "/admin/reports"
            },
            {
              "scheme": "https",
              "host": "ourlime.com",
              "pathPrefix": "/register"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#202020"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "BLUETOOTH",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ],
      "versionCode": 11
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/transparentLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ourlime requires camera access for video calls.",
          "microphonePermission": "Ourlime requires microphone access for voice and video calls and to record voice notes in chat."
        }
      ],
      "./plugins/withOurlimeNotifications.cjs",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10b981",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/messaging",
      "./plugins/withOurlimeCalling.cjs",
      "./plugins/withOurlimeMedia.cjs",
      "./plugins/withOurlimeAppUpdate.cjs",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "privacyManifestAggregationEnabled": true
          },
          "android": {
            "usesCleartextTraffic": true,
            "newArchEnabled": false,
            "largeHeap": true
          }
        }
      ],
      "expo-image",
      "expo-audio",
      "@react-native-firebase/auth",
      "expo-font",
      "expo-sharing",
      "expo-sqlite",
      "expo-video",
      "expo-web-browser",
      "expo-asset",
      "./plugins/withCustomApkName.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2bd2a8c-17f8-4d08-8233-42ccb475a4e5"
      },
      "distribution": "sideload"
    },
    "owner": "uptechincorporate"
  }
}
