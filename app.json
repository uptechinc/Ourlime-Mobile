{
  "expo": {
    "name": "ourlime",
    "slug": "ourlime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ourlime",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ourlime requires camera access for video calls.",
        "NSMicrophoneUsageDescription": "Ourlime requires microphone access for voice and video calls.",
        "LSApplicationQueriesSchemes": [
          "googlegmail",
          "ms-outlook",
          "ymail",
          "protonmail",
          "message",
          "mailto"
        ]
      }
    },
    "android": {
      "package": "com.ourlime.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "BLUETOOTH",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_VIDEO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ourlime requires camera access for video calls.",
          "microphonePermission": "Ourlime requires microphone access for voice and video calls."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2bd2a8c-17f8-4d08-8233-42ccb475a4e5"
      }
    },
    "owner": "a-hazzard"
  }
}
